/* プッシュ通知の文面。**サーバーは文面を作らない**（相手の言語を知らない）。
   `api-user/src/notify.ts` の `LOC_KEYS` が鍵だけを送り、ここで日本語にする。

   ⚠️ **種類を足したら en.lproj にも足すこと。** 片方だけだと、iOS は
   鍵の文字列（`NOTIF_LIKE`）をそのまま通知に出す。
   `Tools/check-config.py` が両方に在ることを見張っている。 */

"NOTIF_LIKE" = "%@ があなたの写真にいいねしました";
"NOTIF_COMMENT" = "%@ がコメントしました";
"NOTIF_FOLLOW" = "%@ があなたをフォローしました";
"NOTIF_STORY_REPLY" = "%@ がストーリーに返信しました";

/* 「この写真を見て撮影」（2026-10-14）。引数は付けた人の名前。文言は Web の `NotificationsBell` と同じ */
"NOTIF_INSPIRED" = "%@ があなたの写真を見て撮影しました";

/* メダル（2026-10-09）。引数はメダルの名前（サーバーが付ける・段つき） */
"NOTIF_BADGE" = "%@のメダルを手に入れました";

/* DM（2026-11-09・`notify.ts` の `pushDmMessage`）。引数は送り主の名前だけ。**本文は載せない**（固定文） */
"NOTIF_DM" = "%@ からメッセージが届きました";

/* ストーリーのメンション（2026-11-09・`notify.ts` の `LOC_KEYS.storymention`）。引数は投稿者の名前。
   サーバーは `PUSH_READY_TYPES` に入れるまで端末へ送らない（この鍵を持つ版を配ってから） */
"NOTIF_STORY_MENTION" = "%@ がストーリーであなたをメンションしました";
