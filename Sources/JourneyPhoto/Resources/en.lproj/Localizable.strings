/* Push notification text. The server sends only the key
   (`api-user/src/notify.ts`), because it doesn't know the reader's language.

   ⚠️ Add every new key to ja.lproj too — otherwise iOS shows the raw key
   (`NOTIF_LIKE`) in the notification. `Tools/check-config.py` checks this. */

"NOTIF_LIKE" = "%@ liked your photo";
"NOTIF_COMMENT" = "%@ commented on your photo";
"NOTIF_FOLLOW" = "%@ followed you";
"NOTIF_STORY_REPLY" = "%@ replied to your story";

/* Medals (2026-10-09). The argument is the medal name sent by the server. */
"NOTIF_BADGE" = "You earned a new medal: %@";
