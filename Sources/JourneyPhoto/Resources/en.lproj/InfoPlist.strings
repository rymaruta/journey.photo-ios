/* System permission prompts. Shown in the device's language. */

"NSCameraUsageDescription" = "Used to take photos you post, and to shoot with an example photo overlaid.";
"NSPhotoLibraryUsageDescription" = "Used to pick photos to post, and to find trips from when and where your photos were taken and line them up in your trip records. Trips are found on this iPhone only; neither photos nor locations are uploaded (only a rough location is sent to Apple Maps to name a trip). Only the photos you choose are posted.";
"NSPhotoLibraryAddUsageDescription" = "Used to save photos you take back to your library.";
"NSLocationWhenInUseUsageDescription" = "Used on the photo map to show where you are and which way you face, and to move the map around you. With Pass turned on, only an approximate position (rounded to about 1 km) is sent to Apple Maps to look up the town where you passed someone; the town and a rough position are kept only on this device. Your location is never sent to Journey Photo’s servers.";
"NSBluetoothAlwaysUsageDescription" = "With Pass turned on, Bluetooth is used to find Journey Photo users nearby and swap your card: the public photo you chose, your note and the from/to text on the ticket. If you choose to show where you live, they see the prefecture from your profile. No location or contact details are sent.";
"CFBundleDisplayName" = "Journey Photo";
